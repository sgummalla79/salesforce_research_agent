# ── Auth0 ──────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# Never commit .env.local

VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=https://your-tenant.auth0.com/api/v2/

# ── Dev server ────────────────────────────────────────────────────────────────
# Port the Vite dev server listens on. Tauri's devUrl must match this.
# Default: 3000
VITE_DEV_PORT=3000

# ── Backend API ────────────────────────────────────────────────────────────────
# Option A (external backend): point to your running FastAPI instance
VITE_API_BASE_URL=http://localhost:8000

# ── Logging / Grafana Loki ─────────────────────────────────────────────────────
# Leave VITE_LOKI_URL blank to keep logs console-only; no code change needed
VITE_LOKI_URL=
VITE_LOKI_AUTH_TOKEN=
VITE_LOKI_APP_LABEL=pragna-desktop

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable a feature before it is fully released.
# Prefix: VITE_FEATURE_<NAME>
# (none yet)
